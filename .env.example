# Copie para .env (que está no .gitignore) e preencha para rodar localmente.
# No GitHub Actions nada disso existe: os valores vêm dos secrets do repositório,
# e o ambiente sempre vence o .env.
#
# Só as duas primeiras são obrigatórias — e apenas fora do dry run.
# Todo o resto tem padrão e só precisa aparecer aqui se você quiser mudar.

# --- Obrigatórias ---------------------------------------------------------

# Discord > Config. do canal > Integrações > Webhooks. Trate como senha.
DISCORD_WEBHOOK_URL=
# https://aistudio.google.com/apikey (grátis, sem cartão)
GEMINI_API_KEY=

# --- Modo de execução -----------------------------------------------------

# 1 imprime o boletim em vez de publicar. Sem GEMINI_API_KEY, imprime só a coleta.
DRY_RUN=0
# 1 publica de novo mesmo se o boletim de hoje já saiu.
FORCE=0

# --- Tempo ----------------------------------------------------------------

TIMEZONE=America/Sao_Paulo
# Quantas horas para trás a coleta olha.
WINDOW_HOURS=26

# --- Modelo ---------------------------------------------------------------

# Fique na linha Flash: a Pro saiu do free tier em abril de 2026.
MODEL=gemini-3.7-flash
# Reservas, em ordem, para quando a principal responder 503 por sobrecarga.
# Vazio desliga a troca de modelo.
MODEL_FALLBACK=gemini-3.6-flash,gemini-3.5-flash
MODEL_TEMPERATURE=0.4
MODEL_MAX_TOKENS=4000
MODEL_THINKING=low
# Quantas vezes percorrer a fila de modelos antes de desistir do boletim.
ATTEMPTS=2

# --- Rede -----------------------------------------------------------------

TIMEOUT_SECONDS=20
# Escrever o boletim demora bem mais que buscar um feed — mas sem teto uma
# requisição travada segura a execução até o workflow matar o job.
GEMINI_TIMEOUT=120
DISCORD_TIMEOUT=30
# Requisições simultâneas na coleta.
WORKERS=8

# --- Coleta e peneira -----------------------------------------------------

# Entradas lidas de cada feed antes do corte por data.
MAX_ENTRIES_PER_FEED=25
# Teto por fonte, para nenhuma sequestrar o dia.
MAX_PER_SOURCE=6
# Quantos itens cabem na lista crua enviada ao modelo.
MAX_ITEMS_IN_PROMPT=85
# Abaixo disso o dia é fraco e o boletim não sai.
MIN_ITEMS_TO_PUBLISH=3
HN_MIN_POINTS=80
HN_RESULTS_PER_TERM=10

# --- Arquivos (relativos à raiz do repositório) ---------------------------

HISTORY_FILE=history.json
SOURCES_FILE=config/sources.toml
PROMPT_FILE=config/prompt.md
# Por quantos dias lembrar de um link já publicado.
HISTORY_DAYS=14

# --- Discord --------------------------------------------------------------

# Limite da API do Discord por mensagem; mexa só para testar a quebra em partes.
DISCORD_LIMIT=2000
